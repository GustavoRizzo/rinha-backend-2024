# Copie para `.env` e ajuste. O `.env` é gitignored.
#
# Chave de assinatura do Django. Gere uma com:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# 1 liga o modo debug. Mantenha 0 em qualquer medição de performance: medimos
# ~4,5% de vazão a menos, porque o Django troca o cursor por CursorDebugWrapper
# e cronometra cada query. (Não há vazamento de memória sob WSGI: reset_queries
# está ligado ao sinal request_started. Ver performance/01-debug-vs-producao.md.)
DJANGO_DEBUG=0
